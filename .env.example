# Copiar como .env. Las credenciales de los portales NO van aquí:
# se guardan por usuario en el Administrador de credenciales de Windows
# desde el botón de la llave en la app.

# La anon key es pública por diseño; la seguridad la da RLS en Supabase.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=reportes

# Soriana está detrás de Cloudflare: en headless el challenge nunca pasa.
# No lo pongas en true salvo que quites Soriana de la corrida.
HEADLESS=false
